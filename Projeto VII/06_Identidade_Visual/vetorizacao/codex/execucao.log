/bin/zsh -lc "python3 apoio/gerar-vetores.py && node apoio/renderizar.mjs && python3 - <<'PY'
from pathlib import Path
from collections import Counter
import xml.etree.ElementTree as ET
import numpy as np
from PIL import Image
raiz=Path('.')
linhas=[]
for arquivo in sorted(raiz.glob('*.svg')):
    r=ET.parse(arquivo).getroot()
    ids=[e.attrib['id'] for e in r.iter() if 'id' in e.attrib]
    assert not [k for k,v in Counter(ids).items() if v>1], arquivo
    proibidos={'image','filter','mask','script','foreignObject','use'}
    assert not any(e.tag.split('}')[-1] in proibidos for e in r.iter()),arquivo
    assert not any('href' in k for e in r.iter() for k in e.attrib),arquivo
    for e in r.iter():
        if e.tag.endswith('path'):
            assert not any(c in e.attrib['d'] for c in 'CcQqSsTt'),arquivo
    linhas.append(f'{arquivo.name}: XML válido; IDs únicos; sem raster, curvas livres ou referências externas.')
for nome in ['logo-final','logo-alternativa-01-micro','logo-alternativa-02-familia','mascote-final','mascote-alternativa-01-acolhimento','mascote-alternativa-02-atencao']:
    im=Image.open(raiz/'previas'/f'{nome}.png').convert('RGBA')
    box=im.getbbox()
    assert box and min(box[:2])>0 and box[2]<600 and box[3]<600,(nome,box)
    linhas.append(f'{nome}: contorno dentro da área de 600 × 600; limites {box}.')
    if nome.startswith('logo-'):
        a=np.asarray(im)[:,:,3].astype(int)
        erro=np.abs(a-a[:,::-1])
        assert erro.mean()<0.1,(nome,erro.mean())
        linhas.append(f'  Simetria raster: diferença média {erro.mean():.5f}/255 (antisserrilhamento).')
relatorio='\\n'.join(linhas)+'\\n'
(raiz/'apoio'/'validacao.txt').write_text(relatorio,encoding='utf-8')
for nome in ['conferencia-logo-alternativa-02-familia.png','conferencia-logo-alternativa-01-micro.png','conferencia-reducao-ampliada.png']:
    (raiz/'previas'/nome).unlink(missing_ok=True)
print(relatorio)
